v {xschem version=3.4.8RC file_version=1.3}
K {type=subcircuit
format="@name @pinlist @symname"
spectre_format="@name ( @pinlist ) @symname"
template="name=x1"
}
T {@symname} -48 -6 0 0 0.25 0.25 {}
T {@name} 65 -42 0 0 0.2 0.2 {}

P 4 4 -60 -60 -60 60 60 0 -60 -60 {}

B 5 -22.5 -82.5 -17.5 -77.5 {name=VCC dir=inout}
L 7 -20 -80 -20 -40 {}
T {VCC} -12 -70 0 0 0.2 0.2 {}

B 5 -82.5 -2.5 -77.5 2.5 {name=IN dir=in}
L 4 -80 0 -60 0 {}
T {IN} -90 -18 0 0 0.2 0.2 {}

B 5 77.5 -2.5 82.5 2.5 {name=OUT dir=out}
L 4 60 0 80 0 {}
T {OUT} 85 -4 0 0 0.2 0.2 {}

B 5 -22.5 77.5 -17.5 82.5 {name=GND dir=inout}
L 7 -20 40 -20 80 {}
T {GND} -12 62 0 0 0.2 0.2 {}
