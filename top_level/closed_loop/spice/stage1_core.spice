x12 vcmfb vcs phi1b phi1 vdd phi2b 0 phi2 vcm_stage1 vo1_b vo1_a S1_CMFB
XPRE_SP sum_p vcm rstb rst vdd 0 S1_TG_SC_LVT
XPRE_SN sum_n vcm rstb rst vdd 0 S1_TG_SC_LVT
XPRE_OP out_p vcm rstb rst vdd 0 S1_TG_SC_LVT
XPRE_ON out_n vcm rstb rst vdd 0 S1_TG_SC_LVT
XCMOUT vdd 0 out_p out_n vcm S1_CMFB_OUT_V1
.ends STAGE1


