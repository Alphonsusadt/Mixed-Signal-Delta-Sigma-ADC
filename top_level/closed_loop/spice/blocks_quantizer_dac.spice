.subckt BUF_B01 VCC IN OUT GND
*.iopin VCC
*.iopin GND
*.ipin IN
*.opin OUT
XM1 net1 IN GND GND sky130_fd_pr__nfet_01v8 L=0.15 W=0.5 nf=1 ad=0.145 as=0.145 pd=1.58 ps=1.58 nrd=0.58 nrs=0.58 sa=0 sb=0 sd=0
+ mult=1
XM2 net1 IN VCC VCC sky130_fd_pr__pfet_01v8 L=0.15 W=1 nf=1 ad=0.29 as=0.29 pd=2.58 ps=2.58 nrd=0.29 nrs=0.29 sa=0 sb=0 sd=0
+ mult=1
XM3 OUT net1 GND GND sky130_fd_pr__nfet_01v8 L=0.15 W=1 nf=1 ad=0.29 as=0.29 pd=2.58 ps=2.58 nrd=0.29 nrs=0.29 sa=0 sb=0 sd=0
+ mult=1
XM4 OUT net1 VCC VCC sky130_fd_pr__pfet_01v8 L=0.15 W=2 nf=1 ad=0.58 as=0.58 pd=4.58 ps=4.58 nrd=0.145 nrs=0.145 sa=0 sb=0 sd=0
+ mult=1
.ends

.subckt SR_Latch SN RN Q QB GND VCC
*.ipin SN
*.ipin RN
*.opin Q
*.opin QB
*.iopin VCC
*.iopin GND
x1 SN QB Q GND VCC NAND2
x2 RN Q QB GND VCC NAND2
.ends

.subckt DAC_1bit VREFP VREFN Q QB VDD GND DAC_P DAC_N
*.iopin VREFP
*.iopin VREFN
*.ipin Q
*.ipin QB
*.iopin VDD
*.iopin GND
*.opin DAC_P
*.opin DAC_N
x1 VREFP DAC_P QB Q VDD GND TG_cell
x2 VREFN DAC_N QB Q VDD GND TG_cell
x3 VREFN DAC_P Q QB VDD GND TG_cell
x4 VREFP DAC_N Q QB VDD GND TG_cell
.ends

.subckt NAND2 A B Y GND VCC
*.ipin A
*.ipin B
*.opin Y
*.iopin GND
*.iopin VCC
XMP1 Y A VCC VCC sky130_fd_pr__pfet_01v8 L=0.15 W=2 nf=1 ad=0.58 as=0.58 pd=4.58 ps=4.58 nrd=0.145 nrs=0.145 sa=0 sb=0 sd=0 mult=1
