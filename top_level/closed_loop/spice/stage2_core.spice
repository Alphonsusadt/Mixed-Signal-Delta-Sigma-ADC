.subckt STAGE2 vin2_p vin2_n out2_p out2_n sum2_p sum2_n vo1_2a vo1_2b vcmfb2 vdd vcm vbias vbz_l vbz_r vcs vcm_stage1 phi1 phi1b phi2 phi2b rst rstb
XSAMP_P vin2_p a2_p phi1b phi1 vdd 0 S2_TG_SC_LVT
CSP a2_p b2_p 1p
XTRANSFER_P b2_p sum2_p phi2b phi2 vdd 0 S2_TG_SC_LVT
XREFT_P a2_p vcm phi2b phi2 vdd 0 S2_TG_SC_LVT
XREFS_P b2_p vcm phi1b phi1 vdd 0 S2_TG_SC_LVT
XSAMP_N vin2_n a2_n phi1b phi1 vdd 0 S2_TG_SC_LVT
CSN a2_n b2_n 1p
XTRANSFER_N b2_n sum2_n phi2b phi2 vdd 0 S2_TG_SC_LVT
XREFT_N a2_n vcm phi2b phi2 vdd 0 S2_TG_SC_LVT
XREFS_N b2_n vcm phi1b phi1 vdd 0 S2_TG_SC_LVT
XOTA2 vdd vcmfb2 vbz_r vbz_l sum2_p sum2_n vo1_2b vo1_2a out2_p out2_n vbias 0 S2_OTA_CMFB
CFP sum2_p out2_p 2p
CFN sum2_n out2_n 2p
CLP out2_p 0 200f
CLN out2_n 0 200f
XSCM2 vcmfb2 vcs phi1b phi1 vdd phi2b 0 phi2 vcm_stage1 vo1_2b vo1_2a S2_CMFB
XOCM2 vdd 0 out2_p out2_n vcm S2_CMFB_OUT_I2_Wired
XPRE_SUM2_P sum2_p vcm rstb rst vdd 0 S2_TG_SC_LVT
XPRE_SUM2_N sum2_n vcm rstb rst vdd 0 S2_TG_SC_LVT
XPRE_OUT2_P out2_p vcm rstb rst vdd 0 S2_TG_SC_LVT
XPRE_OUT2_N out2_n vcm rstb rst vdd 0 S2_TG_SC_LVT
.ends STAGE2


